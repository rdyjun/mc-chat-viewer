WEB_PORT=3000

# PostgreSQL connection (used by both the app and the docker-compose db service)
DB_NAME=mineportal
DB_USER=mineportal
DB_PASSWORD=mineportal

# Azure app registration (Entra ID) for "Sign in with Microsoft" — see README for setup steps.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:3000/api/account/callback

# Comma-separated origins allowed to open the /ws WebSocket connection. Defaults to local dev's
# own origin (http://localhost:3000) when unset; production must set this to its real domain(s),
# e.g. https://mineportal.kr,https://www.mineportal.kr
WS_ALLOWED_ORIGINS=http://localhost:3000
